# ── Lead capture ──────────────────────────────────────────────
# Where contact-form submissions are POSTed as JSON.
# Accepts anything that takes a JSON POST: an n8n webhook, Formspree,
# Zapier catch hook, Make.com, or your own endpoint.
#
# REQUIRED. Without it the form cannot deliver leads — it will show an
# error and fall back to a mailto link instead of failing silently.
VITE_LEAD_ENDPOINT=https://example.app.n8n.cloud/webhook/lawfirm-lead

# Inbox shown to visitors in the mailto fallback when a POST fails.
# Optional — defaults to contact@bytezeroinc.com
VITE_LEAD_EMAIL=contact@bytezeroinc.com

# ── Payload shape POSTed to VITE_LEAD_ENDPOINT ────────────────
# {
#   "name": "John Smith",
#   "email": "john@lawfirm.com",
#   "firm": "Smith & Associates",
#   "practice": "Personal Injury",
#   "message": "...",
#   "source": "footer" | "contact-section",
#   "site": "ca-lawfirm-seo",
#   "submitted_at": "2026-08-03T00:00:00.000Z",
#   "page_url": "https://.../ai-seo-law-firms-california",
#   "page_path": "/ai-seo-law-firms-california",
#   "referrer": "https://google.com/",
#   "utm_source": "...", "utm_medium": "...", "utm_campaign": "...",
#   "utm_term": "...", "utm_content": "...", "gclid": "..."
# }
